import streamlit as st
import yfinance as yf
import numpy as np
import pandas as pd
import plotly.graph_objects as go
from scipy.interpolate import griddata
from scipy.ndimage import gaussian_filter
from scipy.optimize import minimize
from scipy.stats import norm

# ======================================================
# Page Config
# ======================================================
st.set_page_config(page_title="Equity Volatility Surface", layout="wide")
st.title("Equity Options Volatility Surface")

# ======================================================
# Sidebar Controls
# ======================================================
st.sidebar.header("Inputs")

ticker = st.sidebar.text_input("Ticker", "AAPL").upper()
option_type = st.sidebar.selectbox("Option Type", ["call", "put"])
display_mode = st.sidebar.radio("Display Mode", ["Surface", "Market Points"])
moneyness_range = st.sidebar.slider("Strike Range (% of Spot)", 0.7, 1.3, (0.8, 1.2))
show_heston = st.sidebar.checkbox("Show Heston Fair Value", True)
use_forward = st.sidebar.checkbox("Use Forward-Moneyness", False)
use_delta = st.sidebar.checkbox("Use Delta X-axis (instead of Moneyness)", False)
advanced = st.sidebar.checkbox("Advanced: Select Expiries", False)

# ======================================================
# Load Options Data
# ======================================================
@st.cache_data
def load_options(ticker, option_type):
    stock = yf.Ticker(ticker)
    spot = stock.history(period="1d")["Close"].iloc[-1]

    rows = []
    for exp in stock.options:
        chain = stock.option_chain(exp)
        df = chain.calls if option_type == "call" else chain.puts
        df = df[df.impliedVolatility > 0]
        df["expiry"] = exp
        df["days"] = (pd.to_datetime(exp) - pd.Timestamp.today()).days
        df["moneyness"] = df["strike"] / spot
        rows.append(df)

    return spot, pd.concat(rows, ignore_index=True)

spot, df = load_options(ticker, option_type)

df = df[
    (df.moneyness >= moneyness_range[0]) &
    (df.moneyness <= moneyness_range[1]) &
    (df.days > 0)
]

if advanced:
    selected_expiries = st.sidebar.multiselect(
        "Select Expiries",
        sorted(df.expiry.unique()),
        default=sorted(df.expiry.unique())
    )
    df = df[df.expiry.isin(selected_expiries)]

# ======================================================
# Heston Model
# ======================================================
def heston_iv(T, params):
    kappa, theta, sigma, rho, v0 = params
    return np.sqrt(theta + (v0 - theta) * np.exp(-kappa * T / 365))

def loss(params):
    return np.mean(
        (heston_iv(df.days.values, params) - df.impliedVolatility.values) ** 2
    )

res = minimize(
    loss,
    [1.5, 0.04, 0.5, -0.5, 0.04],
    bounds=[(0.01,5),(0.01,1),(0.01,2),(-0.99,0.99),(0.01,1)]
)

df["heston_iv"] = heston_iv(df.days.values, res.x)

# ======================================================
# Forward / Delta Axis
# ======================================================
def forward_price(S, T, r=0.01, q=0.0):
    return S * np.exp((r - q) * T / 365)

if use_forward:
    df["forward"] = df["days"].apply(lambda x: forward_price(spot, x))
    df["moneyness_fwd"] = df["strike"] / df["forward"]
    x_axis_label = "Forward-Moneyness (K / F)"
else:
    df["moneyness_fwd"] = df["moneyness"]
    x_axis_label = "Moneyness (K / Spot)"

def black_scholes_delta(S, K, T, r, sigma, option_type="call"):
    T = np.maximum(T / 365, 1e-6)
    d1 = (np.log(S / K) + 0.5 * sigma**2 * T) / (sigma * np.sqrt(T))
    return norm.cdf(d1) if option_type == "call" else norm.cdf(d1) - 1

if use_delta:
    df["delta"] = df.apply(
        lambda r: black_scholes_delta(
            spot, r["strike"], r["days"], 0.01, r["impliedVolatility"], option_type
        ),
        axis=1
    )
    x_data = df["delta"].values
    x_axis_label = "Delta"
else:
    x_data = df["moneyness_fwd"].values

# ======================================================
# Stable Surface Builder
# ======================================================
def build_surface(x, y, z, Xg, Yg):
    Z_lin = griddata((x, y), z, (Xg, Yg), method="linear")
    Z_near = griddata((x, y), z, (Xg, Yg), method="nearest")
    Z = np.where(np.isnan(Z_lin), Z_near, Z_lin)
    return gaussian_filter(Z, sigma=1.2)

# ======================================================
# Build Surfaces
# ======================================================
x_grid = np.linspace(x_data.min(), x_data.max(), 45)
t_grid = np.linspace(df.days.min(), df.days.max(), 35)
Xg, Yg = np.meshgrid(x_grid, t_grid)

Z_mkt = build_surface(x_data, df.days.values, df.impliedVolatility.values, Xg, Yg)
Z_hes = build_surface(x_data, df.days.values, df.heston_iv.values, Xg, Yg)
Z_diff = Z_mkt - Z_hes

# ======================================================
# Relative Value Callouts (NEW)
# ======================================================
diff_flat = df.impliedVolatility.values - df.heston_iv.values
rich_idx = np.argmax(diff_flat)
cheap_idx = np.argmin(diff_flat)

rich_row = df.iloc[rich_idx]
cheap_row = df.iloc[cheap_idx]

st.markdown("### Relative Value Highlights")
st.markdown(
    f"""
**Richest pocket vs model:**  
{rich_row['strike']:.0f} strike • {int(rich_row['days'])}D expiry • **+{diff_flat[rich_idx]:.2f} vols vs Heston**

**Cheapest pocket vs model:**  
{cheap_row['strike']:.0f} strike • {int(cheap_row['days'])}D expiry • **{diff_flat[cheap_idx]:.2f} vols vs Heston**

*Relative to fitted Heston surface*
"""
)

# ======================================================
# Axis Legend
# ======================================================
axis_legend = dict(
    text=(
        "<b>Axis Guide</b><br>"
        f"X: {x_axis_label}<br>"
        "Y: Time to Expiry (Days)<br>"
        "Z: Implied Volatility"
    ),
    showarrow=False,
    x=1.05,
    y=0.95,
    xref="paper",
    yref="paper",
    align="left",
    font=dict(size=11)
)

# ======================================================
# Market & Heston Charts
# ======================================================
col1, col2 = st.columns(2)

with col1:
    fig_market = go.Figure()
    if display_mode == "Surface":
        fig_market.add_surface(x=Xg, y=Yg, z=Z_mkt, colorscale="Viridis")
    else:
        fig_market.add_scatter3d(
            x=df.strike, y=df.days, z=df.impliedVolatility,
            mode="markers",
            marker=dict(size=4, color=df.impliedVolatility, colorscale="Viridis")
        )

    fig_market.update_layout(
        title="Market Implied Volatility",
        scene=dict(
            xaxis_title=x_axis_label if display_mode == "Surface" else "Strike",
            yaxis_title="Time to Expiry (Days)",
            zaxis_title="Implied Volatility"
        ),
        annotations=[axis_legend],
        template="plotly_dark",
        height=650
    )
    st.plotly_chart(fig_market, use_container_width=True)

with col2:
    if show_heston:
        fig_heston = go.Figure()
        if display_mode == "Surface":
            fig_heston.add_surface(x=Xg, y=Yg, z=Z_hes, colorscale="Plasma")
        else:
            fig_heston.add_scatter3d(
                x=df.strike, y=df.days, z=df.heston_iv,
                mode="markers",
                marker=dict(size=4, color=df.heston_iv, colorscale="Plasma")
            )

        fig_heston.update_layout(
            title="Heston Fair Value",
            scene=dict(
                xaxis_title=x_axis_label if display_mode == "Surface" else "Strike",
                yaxis_title="Time to Expiry (Days)",
                zaxis_title="Implied Volatility"
            ),
            annotations=[axis_legend],
            template="plotly_dark",
            height=650
        )
        st.plotly_chart(fig_heston, use_container_width=True)

# ======================================================
# Market − Model Difference
# ======================================================
if show_heston:
    fig_diff = go.Figure()
    if display_mode == "Surface":
        fig_diff.add_surface(
            x=Xg, y=Yg, z=Z_diff,
            colorscale="RdBu",
            cmin=-np.nanmax(abs(Z_diff)),
            cmax=np.nanmax(abs(Z_diff))
        )
    else:
        fig_diff.add_scatter3d(
            x=df.strike,
            y=df.days,
            z=df.impliedVolatility - df.heston_iv,
            mode="markers",
            marker=dict(size=4, color=df.impliedVolatility - df.heston_iv, colorscale="RdBu")
        )

    fig_diff.update_layout(
        title="Market − Model Volatility",
        scene=dict(
            xaxis_title=x_axis_label if display_mode == "Surface" else "Strike",
            yaxis_title="Time to Expiry (Days)",
            zaxis_title="Vol Difference"
        ),
        annotations=[axis_legend],
        template="plotly_dark",
        height=650
    )
    st.plotly_chart(fig_diff, use_container_width=True)

# ======================================================
# Skew Slice + Skew Metric (FIXED)
# ======================================================
st.subheader("Skew Slice")

# ATM selection (always safe)
atm = df.iloc[(df["moneyness_fwd"] - 1.0).abs().argsort()[:1]]

skew_value = None

if "delta" in df.columns:
    # True delta-based skew
    puts = df[df["delta"] < 0]
    if not puts.empty and not atm.empty:
        p25 = puts.iloc[(puts["delta"] + 0.25).abs().argsort()[:1]]
        skew_value = (
            p25["impliedVolatility"].values[0]
            - atm["impliedVolatility"].values[0]
        )
        skew_label = "Downside Skew (25Δ Put − ATM)"

else:
    # Moneyness proxy skew (clean fallback)
    puts = df[df["moneyness_fwd"] < 0.9]
    if not puts.empty and not atm.empty:
        p_proxy = puts.iloc[
            (puts["moneyness_fwd"] - 0.9).abs().argsort()[:1]
        ]
        skew_value = (
            p_proxy["impliedVolatility"].values[0]
            - atm["impliedVolatility"].values[0]
        )
        skew_label = "Downside Skew (90% Moneyness − ATM)"

if skew_value is not None:
    st.markdown(f"**{skew_label}: {skew_value:.2f} vols**")


# ======================================================
# ATM Term-Structure Ribbon
# ======================================================
st.subheader("ATM Term-Structure")

df["atm_diff"] = np.abs(df["moneyness_fwd"] - 1.0)
atm_df = df.loc[df.groupby("expiry")["atm_diff"].idxmin()]

fig_atm = go.Figure()
fig_atm.add_trace(go.Scatter(
    x=atm_df.days, y=atm_df.impliedVolatility,
    mode="lines+markers", name="ATM Market IV"
))
fig_atm.add_trace(go.Scatter(
    x=atm_df.days, y=atm_df.heston_iv,
    mode="lines", name="ATM Heston IV"
))

fig_atm.update_layout(
    title="ATM Vol Term-Structure",
    xaxis_title="Time to Expiry (Days)",
    yaxis_title="Implied Volatility",
    template="plotly_dark"
)
st.plotly_chart(fig_atm, use_container_width=True)
